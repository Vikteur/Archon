package {{{package}}};

import org.junit.jupiter.api.Test;

import java.util.List;

import static org.assertj.core.api.Assertions.assertThat;

class {{{Name}}}ConverterTest {

    private final {{{Name}}}Converter converter = new {{{Name}}}Converter();

    @Test
    void givenValues_whenConvertToDatabaseColumn_thenJoinThem() {
        assertThat(converter.convertToDatabaseColumn(List.of("a", "b"))).isEqualTo("a{{{separator}}}b");
    }

    @Test
    void givenColumn_whenConvertToEntityAttribute_thenSplitIt() {
        assertThat(converter.convertToEntityAttribute("a{{{separator}}}b")).containsExactly("a", "b");
    }

    @Test
    void givenNull_whenConvert_thenReturnEmpty() {
        assertThat(converter.convertToDatabaseColumn(null)).isEmpty();
        assertThat(converter.convertToEntityAttribute(null)).isEmpty();
    }

    @Test
    void givenEmptyColumn_whenConvertToEntityAttribute_thenReturnEmptyList() {
        assertThat(converter.convertToEntityAttribute("")).isEmpty();
    }
}
