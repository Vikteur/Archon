{{!
  Adapter module build file: OpenAPI-generated controller interfaces + DTOs, Spring Data JPA, Flyway, and a
  Testcontainers Postgres for the repository slice tests.
  Exemplars: vaccination-adapter/build.gradle.kts (openApiConventions), authentication-adapter/build.gradle.kts (JPA)
  Target: <capability>-adapter/build.gradle.kts
  Vars:   capability, gateway (bool: the context has its own <capability>-gateway module),
          apiPackage (the controller package), apis (contract tags, e.g. "Vaccination"),
          models (generated models, comma-separated, e.g. "vaccinations,vaccination")
  Left to you: shared gateway modules the adapter calls (e-health-gateway, vitalink-gateway, ...).
}}
plugins {
    id("mijngezondheid.bom-conventions")
    id("mijngezondheid.openapi-conventions")
}

openApiConventions {
    apiPackage = "{{{apiPackage}}}"
    globalProperties = mapOf(
        "apis" to "{{{apis}}}",
        "models" to "{{{models}}}"
    )
}

dependencies {
    implementation(project(":{{{capability}}}-usecase"))
    implementation(project(":logging"))
{{#gateway}}
    implementation(project(":{{{capability}}}-gateway"))
{{/gateway}}
    implementation("org.springframework.boot:spring-boot-starter-data-jpa")
    implementation("org.springframework.boot:spring-boot-starter-flyway")
    implementation("org.flywaydb:flyway-database-postgresql")
    testImplementation(project(":{{{capability}}}-domain", "testArtifacts"))
{{#gateway}}
    testImplementation(project(":{{{capability}}}-gateway", "testArtifacts"))
{{/gateway}}
    testImplementation("org.testcontainers:testcontainers-postgresql")
    testImplementation("org.postgresql:postgresql")
    testImplementation("org.springframework.boot:spring-boot-starter-data-jpa-test")
}
