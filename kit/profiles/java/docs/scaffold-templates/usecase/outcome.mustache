{{/imports.length}}
{{#imports}}
import {{.}};
{{/imports}}

public sealed interface {{Name}}Outcome {
{{#cases}}

    record {{Case}}({{#fields}}{{{type}}} {{name}}{{^last}}, {{/last}}{{/fields}}) implements {{Name}}Outcome {
    }
{{/cases}}
}
