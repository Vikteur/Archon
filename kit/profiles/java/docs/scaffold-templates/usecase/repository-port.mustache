{{!
  Read port owned by the usecase layer; names domain types only. Exemplar: account-usecase SalesRegionRepository.
  Every method takes the caller's OrganisationId first: a port never reads another organisation's rows.
  Two shapes, render one or both:
    method:  a query the use case returns as is (usecase.mustache), e.g. List<Gadget> findAll; no adapter template
             implements it: hand-write it in Default<Name>Repository, scoped by organisationId like the lookup;
    Key:     a lookup by key, implemented by adapter/default-repository.
  Target: <capability>-usecase/src/main/java/<package path>/repository/<Name>Repository.java
  Package: "package" is the base package, without the ".repository" this template appends (com.example.guest renders
          package com.example.guest.repository); <package path> is that base as a path. scripts/scaffold.sh refuses a
          target outside the directory of the package the file declares.
  Vars:   package, basePackage (root holding common/), Name (aggregate),
          method + Result (query: port method, domain return type; generics allowed, then import the element type by hand),
          Key + key + keyType (lookup: PascalCase key, camelCase key, key type such as GadgetId)
}}
package {{package}}.repository;

import {{basePackage}}.common.domain.OrganisationId;
import {{package}}.domain.*;
{{#Key}}

import java.util.Optional;
{{/Key}}

public interface {{Name}}Repository {
{{#method}}
    {{{Result}}} {{method}}(OrganisationId organisationId);
{{/method}}
{{#Key}}
    Optional<{{Name}}> findBy{{Key}}(OrganisationId organisationId, {{{keyType}}} {{key}});
{{/Key}}
}
