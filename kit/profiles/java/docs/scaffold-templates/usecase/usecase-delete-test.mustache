@ExtendWith(MockitoExtension.class)
class Delete{{Name}}UseCaseTest {
    private static final OrganisationId ORGANISATION = OrganisationId.of(UUID.fromString("00000000-0000-4000-8000-000000000001"));

    @Mock
    private {{Name}}Repository {{name}}Repository;
    @InjectMocks
    private Delete{{Name}}UseCase useCase;

    @Test
    void givenExisting{{Key}}_whenExecute_thenDelete() {
