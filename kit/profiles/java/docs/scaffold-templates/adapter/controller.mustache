import {{basePackage}}.common.adapter.controller.CurrentOrganisation;
import {{modelPackage}}.{{Domain}}DTO;
import {{package}}.usecase.{{UseCase}};
import lombok.RequiredArgsConstructor;

@RequiredArgsConstructor
public class {{Name}}Controller implements {{Api}} {

    private final {{UseCase}} {{useCase}};
    private final CurrentOrganisation currentOrganisation;

    @Override
    public {{Domain}}DTO {{operationId}}() {
        return {{Domain}}ToDTOMapper.map({{useCase}}.execute(currentOrganisation.get()));
    }
}
