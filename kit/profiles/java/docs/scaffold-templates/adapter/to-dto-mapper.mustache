{{!
  Static, field-explicit domain to DTO mapper (no MapStruct). Exemplar: account-adapter DelegationToDTOMapper.
  Target: <capability>-adapter/src/main/java/<package path>/adapter/controller/<Domain>ToDTOMapper.java
  Package: "package" is the base package, without the ".adapter.controller" this template appends (com.example.guest
          renders package com.example.guest.adapter.controller); <package path> is that base as a path.
          scripts/scaffold.sh refuses a target outside the directory of the package the file declares.
  Vars:   package, modelPackage (package of the generated DTOs), Domain, domain (camelCase),
          record (bool: domain is a record), fields[name, pascal]
}}
package {{package}}.adapter.controller;

import {{modelPackage}}.{{Domain}}DTO;
import {{package}}.domain.{{Domain}};
import lombok.AccessLevel;
import lombok.NoArgsConstructor;

@NoArgsConstructor(access = AccessLevel.PRIVATE)
public class {{Domain}}ToDTOMapper {

    static {{Domain}}DTO map({{Domain}} {{domain}}) {
        return {{Domain}}DTO.builder()
{{#fields}}
                .{{name}}({{domain}}.{{#record}}{{name}}{{/record}}{{^record}}get{{pascal}}{{/record}}())
{{/fields}}
                .build();
    }
}
