import {{modelPackage}}.{{Dto}}DTO;
import {{package}}.domain.*;
import lombok.AccessLevel;
import lombok.NoArgsConstructor;

@NoArgsConstructor(access = AccessLevel.PRIVATE)
public final class {{Name}}RequestDTOToDomainMapper {

    public static CreateOrUpdate{{Name}}Request map(OrganisationId organisationId, {{Dto}}DTO dto) {
        return CreateOrUpdate{{Name}}Request.builder()
                .organisationId(organisationId)
{{#fields}}
                .{{name}}({{#enumType}}dto.get{{pascal}}() == null ? null : {{enumType}}.valueOf(dto.get{{pascal}}().name()){{/enumType}}{{#typedId}}dto.get{{pascal}}() == null ? null : {{typedId}}.of(dto.get{{pascal}}()){{/typedId}}{{^enumType}}{{^typedId}}dto.get{{pascal}}(){{/typedId}}{{/enumType}})
{{/fields}}
                .build();
    }
}
