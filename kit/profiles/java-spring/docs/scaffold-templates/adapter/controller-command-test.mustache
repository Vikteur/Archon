{{!
  Write-controller spec over HTTP: 204 on success, the status of ErrorStatusTable + the notification body on an error
  (422 VALIDATION_FAILED without a code, 404 NOT_FOUND for an unknown key).
  @WebMvcTest slice + MockMvc, the use cases and CurrentOrganisation replaced by @MockitoBean (Spring Boot 3.4+). The
  slice loads this controller and the @RestControllerAdvice, no database; it needs a @SpringBootConfiguration in a
  parent package on the test classpath (the shared adapter test application).
  Add @WithMockUser (spring-security-test) when the endpoint needs a user.
  Mapping details belong in the request mapper's own test; here only the key and the organisation are checked.
  Target: <capability>-adapter/src/test/java/<package path>/adapter/controller/<Name>ControllerTest.java
  Package: "package" is the base package, without the ".adapter.controller" this template appends (com.example.guest
          renders package com.example.guest.adapter.controller); <package path> is that base as a path.
          scripts/scaffold.sh refuses a target outside the directory of the package the file declares.
  Vars:   package, basePackage (root holding common/), Name, Domain, Key, keyExample (domain key, Java literal),
          UpsertOperationId, DeleteOperationId (PascalCase), httpMethod (post or put), upsertPath,
          deletePath (key filled in), requestJson
}}
package {{package}}.adapter.controller;

import {{basePackage}}.common.adapter.controller.CurrentOrganisation;
import {{basePackage}}.common.domain.OrganisationId;
import {{basePackage}}.common.domain.validation.ErrorCode;
import {{basePackage}}.common.domain.validation.Notification;
import {{package}}.domain.*;
import {{package}}.usecase.CreateOrUpdate{{Domain}}UseCase;
import {{package}}.usecase.Delete{{Domain}}UseCase;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Nested;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;

import java.util.UUID;

import static org.hamcrest.Matchers.contains;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.argThat;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;
import static org.springframework.http.MediaType.APPLICATION_JSON;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.{{httpMethod}};
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@WebMvcTest({{Name}}Controller.class)
class {{Name}}ControllerTest {
    private static final OrganisationId ORGANISATION = OrganisationId.of(UUID.fromString("00000000-0000-4000-8000-000000000001"));

    @Autowired
    MockMvc mockMvc;

    @MockitoBean
    CreateOrUpdate{{Domain}}UseCase createOrUpdate{{Domain}}UseCase;

    @MockitoBean
    Delete{{Domain}}UseCase delete{{Domain}}UseCase;

    @MockitoBean
    CurrentOrganisation currentOrganisation;

    @BeforeEach
    void signIn() {
        when(currentOrganisation.get()).thenReturn(ORGANISATION);
    }

    @Nested
    class {{UpsertOperationId}} {
        @Test
        void givenValidRequest_when{{UpsertOperationId}}_thenReturnNoContent() throws Exception {
            when(createOrUpdate{{Domain}}UseCase.execute(any(CreateOrUpdate{{Domain}}Request.class)))
                    .thenReturn(Notification.empty());

            mockMvc.perform({{httpMethod}}("{{{upsertPath}}}").contentType(APPLICATION_JSON).content(REQUEST))
                    .andExpect(status().isNoContent());

            verify(createOrUpdate{{Domain}}UseCase).execute(argThat(request ->
                    request.getOrganisationId().equals(ORGANISATION) && request.get{{Key}}().equals({{{keyExample}}})));
        }

        @Test
        void givenRejectedRequest_when{{UpsertOperationId}}_thenReturnUnprocessableWithErrors() throws Exception {
            when(createOrUpdate{{Domain}}UseCase.execute(any(CreateOrUpdate{{Domain}}Request.class)))
                    .thenReturn(Notification.of("my error message"));

            mockMvc.perform({{httpMethod}}("{{{upsertPath}}}").contentType(APPLICATION_JSON).content(REQUEST))
                    .andExpect(status().isUnprocessableEntity())
                    .andExpect(jsonPath("$.errors", contains("my error message")))
                    .andExpect(jsonPath("$.code").value("VALIDATION_FAILED"));
        }
    }

    @Nested
    class {{DeleteOperationId}} {
        @Test
        void givenExisting{{Key}}_when{{DeleteOperationId}}_thenReturnNoContent() throws Exception {
            when(delete{{Domain}}UseCase.execute(ORGANISATION, {{{keyExample}}})).thenReturn(Notification.empty());

            mockMvc.perform(delete("{{{deletePath}}}"))
                    .andExpect(status().isNoContent());
        }

        @Test
        void givenUnknown{{Key}}_when{{DeleteOperationId}}_thenReturnNotFound() throws Exception {
            when(delete{{Domain}}UseCase.execute(ORGANISATION, {{{keyExample}}}))
                    .thenReturn(Notification.of(ErrorCode.NOT_FOUND, "not found"));

            mockMvc.perform(delete("{{{deletePath}}}"))
                    .andExpect(status().isNotFound())
                    .andExpect(jsonPath("$.errors", contains("not found")))
                    .andExpect(jsonPath("$.code").value("NOT_FOUND"));
        }
    }

    private static final String REQUEST = """
            {{{requestJson}}}
            """;
}
