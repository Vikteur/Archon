# Sends the owner's bundle of queued info and warn pings as one phone ping (owner decision 2026-10-23, docs/memory.md):
# `notify-owner.sh --flush`. Started by notify-digest.timer at 08:00 and 17:30. Install: docs/archon/notify.md. This
# file is checked in; the owner installs it.
[Unit]
Description=Send the bundled owner pings (notify-owner.sh --flush)
Documentation=file://@@KIT_PROJECT_DIR@@/docs/archon/notify.md

[Service]
Type=oneshot
WorkingDirectory=@@KIT_PROJECT_DIR@@
# A unit does not get the login PATH: gh, jq, node and backlog live in these folders.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash @@KIT_PROJECT_DIR@@/.archon/scripts/notify-owner.sh --flush
TimeoutStartSec=300
Nice=10
