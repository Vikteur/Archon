# Template for notify-owner.sh's config (owner decision D9: phone pings through ntfy). The owner copies it OUTSIDE the
# repo and fills it in; the real file is never checked in (its topic is a secret, a STOP item):
#   mkdir -p ~/.config/notify-owner && cp .archon/notify/ntfy.env.example ~/.config/notify-owner/ntfy.env
#   chmod 600 ~/.config/notify-owner/ntfy.env
# notify-owner.sh refuses the file while it is readable by others. Setup steps: docs/archon/notify.md.
# KEY=VALUE lines only; the file is read, never run.

# The ntfy server: https://ntfy.sh, or your own server's https URL.
NTFY_URL=https://ntfy.sh
# The secret topic: 20 to 64 random letters and digits, for example from `openssl rand -hex 16`. Anyone who knows it
# can read your pings, so never share it. Replace the placeholder below.
NTFY_TOPIC=CHANGE-ME-to-a-random-topic
# Optional: an access token, only when your server requires one (ntfy.sh reserved topics, a self-hosted ACL).
NTFY_TOKEN=

# Optional settings; the defaults are shown.
# NTFY_PRIORITY_INFO=2          # 1 min, 2 low, 3 default, 4 high, 5 urgent
# NTFY_PRIORITY_WARN=4
# NTFY_PRIORITY_ACT=5
# NOTIFY_DEDUPE_MIN=30          # minutes before the same key is sent again (info, warn)
# NOTIFY_DEDUPE_MIN_ACT=10      # the same for act
# NOTIFY_DAILY_CAP=40           # deliveries per local day
# NOTIFY_QUIET=                 # quiet hours, e.g. 23-07: info and warn arrive silently then; act still rings
# NOTIFY_PR_BASE=               # where "PR #<n>" links to; default: origin's GitHub URL + /pull
# NOTIFY_TIMEOUT=10             # seconds before curl gives up
# NOTIFY_BUNDLE=on              # off: info and warn are sent at once instead of waiting for the 08:00/17:30 bundle
# NOTIFY_FLUSH_MAX_H=14         # a bundle older than this many hours goes out with the next ping
# NOTIFY_OPEN_DAYS=7            # an open ping (--about) whose subject never resolves is forgotten after this
