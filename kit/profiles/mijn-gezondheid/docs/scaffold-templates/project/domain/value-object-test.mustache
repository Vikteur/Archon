package {{{package}}};

import org.junit.jupiter.api.Test;
{{#imports}}
import {{{.}}};
{{/imports}}

import static org.assertj.core.api.Assertions.assertThat;

class {{{Name}}}Test {

    @Test
    void givenValidValue_whenCreate_thenReturnValueWithoutErrors() {
        // When
        var creation = {{{Name}}}.create({{{example}}});

        // Then
        assertThat(creation.getNotification().hasErrors()).isFalse();
        assertThat(creation.getValue().value()).isEqualTo({{{example}}});
    }

    @Test
    void givenNullValue_whenCreate_thenReturnErrors() {
        // When
        var creation = {{{Name}}}.create(null);

        // Then
        assertThat(creation.getValue()).isNull();
{{#notBlank}}
        assertThat(creation.getNotification().getErrors()).containsExactly("Field '{{{Name}}}.value' should not be blank");
{{/notBlank}}
{{^notBlank}}
        assertThat(creation.getNotification().getErrors()).containsExactly("Field '{{{Name}}}.value' should not be null");
{{/notBlank}}
    }
{{#maxLength}}

    @Test
    void givenValueLongerThanMaximum_whenCreate_thenReturnErrors() {
        // When
        var creation = {{{Name}}}.create("x".repeat({{{maxLength}}} + 1));

        // Then
        assertThat(creation.getValue()).isNull();
        assertThat(creation.getNotification().getErrors())
                .containsExactly("Field '{{{Name}}}.value' must be between 0 and {{{maxLength}}}.");
    }
{{/maxLength}}
