package {{package}}.adapter.repository;

import {{basePackage}}.common.domain.OrganisationId;
import {{package}}.domain.*;
import io.quarkus.test.TestTransaction;
import io.quarkus.test.junit.QuarkusTest;
import jakarta.inject.Inject;
import jakarta.persistence.EntityManager;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;

import java.util.UUID;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

@QuarkusTest
@Tag("integration")
class Default{{Name}}RepositoryTest {
    private static final OrganisationId ORGANISATION = OrganisationId.of(UUID.fromString("00000000-0000-4000-8000-000000000001"));
    private static final OrganisationId OTHER_ORGANISATION = OrganisationId.of(UUID.fromString("00000000-0000-4000-8000-000000000002"));

    @Inject
    Default{{Name}}Repository repository;

    @Inject
    EntityManager entityManager;

    @Test
    @TestTransaction
    void givenNew{{Name}}_whenSave_thenInsertRowOfOrganisation() {
        var {{name}} = {{Name}}Mother.{{fixture}}();
        assertThat(findRow()).isNull();

        repository.save(ORGANISATION, {{name}});
        entityManager.clear();

        assertThat({{Name}}EntityMapper.map(findRow())).isEqualTo({{name}});
        assertThat(findRow().getOrganisationId()).isEqualTo(ORGANISATION.value());
    }

    @Test
    @TestTransaction
    void givenExisting{{Name}}_whenSave_thenOverwriteRow() {
        persist(ORGANISATION, {{Name}}Mother.{{fixture}}());
        var updated = {{Name}}Mother.{{Name}}Builder.builder().{{changedField}}({{{changedExample}}}).build();

        repository.save(ORGANISATION, updated);
        entityManager.clear();

        assertThat({{Name}}EntityMapper.map(findRow())).isEqualTo(updated);
    }

    @Test
    @TestTransaction
    void given{{Name}}OfOtherOrganisation_whenSave_thenThrowAndKeepRow() {
        var {{name}} = {{Name}}Mother.{{fixture}}();
        persist(OTHER_ORGANISATION, {{name}});
        var updated = {{Name}}Mother.{{Name}}Builder.builder().{{changedField}}({{{changedExample}}}).build();

        assertThatThrownBy(() -> repository.save(ORGANISATION, updated)).isInstanceOf(IllegalStateException.class);
        entityManager.clear();

        assertThat({{Name}}EntityMapper.map(findRow())).isEqualTo({{name}});
        assertThat(findRow().getOrganisationId()).isEqualTo(OTHER_ORGANISATION.value());
    }

    @Test
    @TestTransaction
    void givenExisting{{Name}}_whenFindById_thenReturnDomain() {
        var {{name}} = {{Name}}Mother.{{fixture}}();
        persist(ORGANISATION, {{name}});

        assertThat(repository.findById(ORGANISATION, {{{keyExample}}})).contains({{name}});
        assertThat(repository.existsById(ORGANISATION, {{{keyExample}}})).isTrue();
    }

    @Test
    @TestTransaction
    void given{{Name}}OfOtherOrganisation_whenFindById_thenReturnEmpty() {
        persist(OTHER_ORGANISATION, {{Name}}Mother.{{fixture}}());

        assertThat(repository.findById(ORGANISATION, {{{keyExample}}})).isEmpty();
        assertThat(repository.existsById(ORGANISATION, {{{keyExample}}})).isFalse();
    }

    @Test
    @TestTransaction
    void givenUnknown{{Key}}_whenFindById_thenReturnEmpty() {
        assertThat(repository.findById(ORGANISATION, {{{unknownKeyExample}}})).isEmpty();
        assertThat(repository.existsById(ORGANISATION, {{{unknownKeyExample}}})).isFalse();
    }

    @Test
    @TestTransaction
    void givenExisting{{Name}}_whenDeleteById_thenRemoveRow() {
        persist(ORGANISATION, {{Name}}Mother.{{fixture}}());

        repository.deleteById(ORGANISATION, {{{keyExample}}});
        entityManager.flush();
        entityManager.clear();

        assertThat(findRow()).isNull();
    }

    @Test
    @TestTransaction
    void given{{Name}}OfOtherOrganisation_whenDeleteById_thenKeepRow() {
        persist(OTHER_ORGANISATION, {{Name}}Mother.{{fixture}}());

        repository.deleteById(ORGANISATION, {{{keyExample}}});
        entityManager.flush();
        entityManager.clear();

        assertThat(findRow()).isNotNull();
    }

    private {{Name}}Entity findRow() {
        return entityManager.find({{Name}}Entity.class, {{{keyExample}}}{{#typedId}}.value(){{/typedId}});
    }

    private void persist(OrganisationId organisationId, {{Name}} {{name}}) {
        entityManager.persist(new {{Name}}Entity(organisationId, {{name}}));
        entityManager.flush();
        entityManager.clear();
    }
}
