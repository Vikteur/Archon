{{!
  Package-private Panache repository (repository pattern, not active record); only the
  Default<Name>Repository adapter uses it. Every lookup is scoped by the row's organisation_id;
  needs io.quarkus:quarkus-hibernate-orm-panache.
  naturalKey (optional, as in jpa-entity): makes its type the @Id type instead of Long
  (PanacheRepositoryBase<Entity, Id>). With naturalKey only (default-repository-crud), leave Key out:
  default-repository-crud writes its organisation-scoped queries itself.
  Target: <capability>-adapter/src/main/java/<package path>/adapter/repository/<Name>PanacheRepository.java
  Package: "package" is the base package, without the ".adapter.repository" this template appends (com.example.guest
          renders package com.example.guest.adapter.repository); <package path> is that base as a path.
          scripts/scaffold.sh refuses a target outside the directory of the package the file declares.
  Vars:   package, Name, Key (optional, PascalCase lookup field), key (entity field name),
          keyType (entity field type), naturalKey (optional: type, typedId (optional, set for a typed id: type is UUID))
}}
package {{package}}.adapter.repository;

{{^naturalKey}}
import io.quarkus.hibernate.orm.panache.PanacheRepository;
{{/naturalKey}}
{{#naturalKey}}
import io.quarkus.hibernate.orm.panache.PanacheRepositoryBase;
{{/naturalKey}}
import jakarta.enterprise.context.ApplicationScoped;
{{#Key}}

import java.util.Optional;
import java.util.UUID;
{{/Key}}
{{^Key}}
{{#naturalKey.typedId}}

import java.util.UUID;
{{/naturalKey.typedId}}
{{/Key}}

@ApplicationScoped
class {{Name}}PanacheRepository implements {{^naturalKey}}PanacheRepository<{{Name}}Entity>{{/naturalKey}}{{#naturalKey}}PanacheRepositoryBase<{{Name}}Entity, {{{type}}}>{{/naturalKey}} {
{{#Key}}

    Optional<{{Name}}Entity> findBy{{Key}}(UUID organisationId, {{{keyType}}} {{key}}) {
        return find("organisationId = ?1 and {{key}} = ?2", organisationId, {{key}}).firstResultOptional();
    }
{{/Key}}
}
